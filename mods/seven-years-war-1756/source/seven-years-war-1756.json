    { "between": ["country:pr", "franco"], "state": "peace", "until": 3,
      "announce": { "commander": "Guderian", "end": {
        "en": "August 1756. Frederick II marches into Saxony without a declaration of war. The war in Europe has begun.",
        "cn": "1756年8月。腓特烈二世不宣而战，进军萨克森。欧洲战争爆发。" } } },
    { "between": ["anglo", "country:ru"], "state": "peace", "until": 5,
      "announce": { "commander": "Zhukov", "end": {
        "en": "1757. Russia joins the coalition against Prussia: Apraksin's army marches into East Prussia.",
        "cn": "1757年。俄国加入反普鲁士同盟：阿普拉克辛的军队攻入东普鲁士。" } } },
    { "between": ["anglo", "country:se"], "state": "peace", "until": 6,
      "announce": { "commander": "Rokossovsky", "end": {
        "en": "September 1757. Sweden lands troops in Pomerania and declares war on Prussia.",
        "cn": "1757年9月。瑞典在波美拉尼亚登陆并对普鲁士宣战。" } } },
    { "between": ["anglo", "country:es"], "state": "peace", "until": 12,
      "announce": { "commander": "de Gaulle", "end": {
        "en": "1762. The Bourbon Family Compact brings Spain into the war beside France.",
        "cn": "1762年。波旁家族盟约使西班牙站到法国一边参战。" } } },
    { "between": ["tag:power", "*"], "state": "peace" }
  ],

