    { "id": "jap", "art": "ja", "faction": "tokugawa", "tags": ["shogunate"], "name": { "en": "TOKUGAWA SHOGUNATE", "cn": "德川幕府" },
      "intro": { "en": "Shogun Ieshige rules a closed country: only Dutch and Chinese ships may trade, at Nagasaki. Japan keeps out of the world's wars.", "cn": "将军德川家重统治着一个锁国的国家：只有荷兰和中国的船只可以在长崎通商。日本置身于世界的战争之外。" },
