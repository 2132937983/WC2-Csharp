    { "id": "ott", "art": "tr", "faction": "ottoman", "tags": ["empire"], "name": { "en": "OTTOMAN EMPIRE", "cn": "奥斯曼帝国" },
      "intro": { "en": "Sultan Osman III rules from the Danube to the Persian Gulf and from Algiers to the Caucasus. The Porte watches Russia and Austria fight Prussia and keeps its peace.", "cn": "苏丹奥斯曼三世统治着从多瑙河到波斯湾、从阿尔及尔到高加索的广袤土地。奥斯曼朝廷旁观俄奥与普鲁士交战，坚守和平。" },
      "color": [195, 100, 70], "techLevel": 2, "capital": [28.98, 41.01], "garrison": 1, "fleets": 3,
      "flag": { "bands": ["#d10f1f"], "overlays": [ { "type": "crescent", "x": 0.42, "y": 0.5, "r": 0.27, "color": "#ffffff" },
        { "type": "star", "x": 0.63, "y": 0.5, "r": 0.11, "points": 8, "inner": 0.5, "color": "#ffffff" } ] } },
    { "id": "plc", "art": "pl", "faction": "commonwealth", "tags": ["commonwealth"], "name": { "en": "POLISH-LITHUANIAN COMMONWEALTH", "cn": "波兰立陶宛联邦" },
      "intro": { "en": "The Commonwealth is vast and weak: its Sejm is paralysed by the liberum veto, its king is the Elector of Saxony, and Russian armies will march across it to reach Prussia.", "cn": "联邦幅员辽阔却十分虚弱：它的议会被自由否决权所瘫痪，它的国王是萨克森选侯，俄国军队将穿过它的领土进攻普鲁士。" },
      "color": [225, 140, 160], "techLevel": 2, "capital": [21.01, 52.23], "garrison": 1,
      "flag": { "bands": ["#dc143c"], "overlays": [
