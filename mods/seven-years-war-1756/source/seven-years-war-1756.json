{
  // THE SEVEN YEARS' WAR, 1756 - conquest 11 on the Natural Earth world map.
  // Spring 1756, on the eve of the war: the Diplomatic Revolution has made France and Austria allies,
  // Britain stands with Prussia, and in America and India the British and French are already fighting.
  //
  // Build:  dotnet run --project Tools -- build-scenario --config mods/seven-years-war-1756/source/seven-years-war-1756.json
  // Check the borders:  add  --preview <file>.png  (the whole world in the owners' colours)
  // Every field: MODDING.md, "A total conversion: build-scenario".
  //
  // The map's provinces follow today's borders and the borders of 1910-1949, so the 1756 borders are drawn
  // from rules over them: today's country, ISO province, longitude and latitude, the nearest province to a
  // place. Where a historical border cuts through one of the map's provinces, the province goes to the
  // side holding most of it (README.md lists the simplifications).

  "mod": {
    "id": "seven-years-war-1756",
    "name": "1756: The Seven Years' War",
    "version": "1.0",
    "description": "Conquest 11: the world on the eve of the Seven Years' War (spring 1756) on the world map: the Anglo-Prussian and Franco-Austrian alliances, the neutral powers, the colonies in America, India and Africa, flags of the period. Needs the world map (map-natural-earth, built in).",
    "priority": 1
  },
  "conquest": 11,
  "map": {
    "id": 2,
    "pack": "assets/data/maps/natural-earth",
    "areas": "mods/map-natural-earth/data/json/maps/2/areas.json"
  },
  "texts": {
    "name": { "en": "1756 SEVEN YEARS' WAR", "cn": "1756 七年战争" },
    "age": { "en": "1756", "cn": "1756" },
    "intro": {
      "en": "Spring 1756. In the Diplomatic Revolution the old enemies France and Austria have become allies, and Britain has turned to Prussia. In the Ohio valley and in India the British and French are already at war. Frederick of Prussia will strike first, at Saxony, in round 3; Russia joins the war in round 5, Sweden in round 6, Spain in round 12. The Ottomans, Poland-Lithuania, Denmark-Norway, Persia, the Mughals, Qing China and Tokugawa Japan stay at peace with everyone.",
      "cn": "1756年春。外交革命使宿敌法国与奥地利结成同盟，英国则转向普鲁士。在俄亥俄河谷和印度，英法两国早已开战。普鲁士的腓特烈将在第3回合率先进攻萨克森；俄国在第5回合参战，瑞典在第6回合，西班牙在第12回合。奥斯曼帝国、波兰立陶宛联邦、丹麦-挪威、波斯、莫卧儿、大清和德川日本与所有国家保持和平。"
    }
  },
  "button": { "title": "1756 SEVEN YEARS' WAR", "lon": -25, "lat": 35, "degreesWide": 150 },
  "camera": { "lon": 10, "lat": 50 },
  "fogOfWar": false,
  "leftRightWrap": true,

  "economy": { "moneyBase": 200, "moneyPerTax": 1.0, "industryBase": 100, "industryPerTax": 0.5 },

  "defaults": {
    "commander": "common1",
    "techLevel": 2,
    "taxFactor": 1.2,
    "fleets": 0,
    "transportCards": true,
    "units": {
      "capital": ["infantry", "infantry", "artillery"],
      "largeCity": ["infantry", "artillery"],
      "city": ["infantry"],
      "port": ["infantry"]
    },
    "intro": {
      "en": "Spring 1756. The great powers of Europe have changed partners, and their quarrel will be fought on four continents.",
      "cn": "1756年春。欧洲列强已经交换了盟友，它们的争端将在四大洲展开。"
    },
    "victory": {
      "en": "Defeat every country at war with you or bound to be. The neutral powers, at peace with everyone, need not fall.",
      "cn": "击败所有正在或将要与你交战的国家。与所有国家和平相处的中立强国无需消灭。"
    }
  },

