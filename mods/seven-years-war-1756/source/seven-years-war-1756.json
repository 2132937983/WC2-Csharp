  // Countries in turn order. "art": the game's own units (and, without a "flag", its flag); a "flag"
  // here is this scenario's flag only (flag_c11_<id>.png), the game's flag stays everywhere else.
  "countries": [
    // ---- the Anglo-Prussian Alliance
    { "id": "gb", "art": "gb", "faction": "anglo", "tags": ["great power", "maritime"],
      "name": { "en": "KINGDOM OF GREAT BRITAIN", "cn": "大不列颠王国" },
      "intro": { "en": "George II rules Britain, Ireland and Hanover. The Royal Navy is the strongest in the world, the Thirteen Colonies are booming, and in the Ohio valley and the Carnatic the war with France has already begun. Pitt will pay Prussia to fight in Europe while Britain takes the colonies.", "cn": "乔治二世统治着大不列颠、爱尔兰和汉诺威。皇家海军冠绝全球，十三殖民地蒸蒸日上，在俄亥俄河谷和卡纳蒂克，与法国的战争早已打响。皮特将出钱让普鲁士在欧洲作战，而英国去夺取殖民地。" },
      "color": [200, 60, 60], "commander": "Montgomery", "techLevel": 3, "capital": [-0.13, 51.51], "garrison": 1, "fleets": 10, "fleetUnit": "battleship", "economy": 1.4,
      "flag": { "bands": ["#012169"], "overlays": [ { "type": "path", "symbol": "union", "full": true, "colors": { "field": "#012169", "white": "#ffffff", "red": "#c8102e" } } ] } },
    { "id": "pr", "art": "de", "faction": "anglo", "tags": ["great power", "military"],
      "name": { "en": "KINGDOM OF PRUSSIA", "cn": "普鲁士王国" },
      "intro": { "en": "Frederick II holds Silesia, taken from Austria in the last two wars, and knows Maria Theresa wants it back with France and Russia at her side. His army is the best drilled in Europe; his kingdom is small and scattered from the Rhine to the Memel. He means to strike first.", "cn": "腓特烈二世占据着在前两场战争中从奥地利夺来的西里西亚，他知道玛丽亚·特蕾莎想在法俄的支持下夺回它。他的军队是欧洲训练最精良的，但他的王国弱小，领土从莱茵河一直散布到梅梅尔河。他打算先发制人。" },
      "color": [55, 75, 135], "commander": "Guderian", "techLevel": 3, "capital": [13.40, 52.52], "garrison": 2, "fleets": 1, "economy": 1.25,
      "flag": { "bands": ["#ffffff"], "overlays": [
        { "type": "path", "symbol": "eagle", "x": 0.5, "y": 0.52, "h": 0.9, "colors": { "body": "#111111", "crown": "#d4a017" } },
        { "type": "path", "symbol": "regalia", "x": 0.5, "y": 0.52, "h": 0.9, "colors": { "gold": "#d4a017", "orb": "#1f4e9a" } },
        { "type": "text", "text": "FR", "x": 0.5, "y": 0.55, "h": 0.17, "color": "#e8b923" } ] } },
    { "id": "han", "faction": "anglo", "tags": ["electorate"], "name": { "en": "ELECTORATE OF HANOVER", "cn": "汉诺威选侯国" },
      "intro": { "en": "King George's German electorate, ruled from London. France will march on it the moment the war begins; Britain has promised an Army of Observation to defend it.", "cn": "乔治国王在德意志的选侯国，由伦敦统治。战争一开始法国就会进军这里；英国已承诺组建一支观察军来保卫它。" },
      "color": [215, 110, 90], "capital": [9.73, 52.37], "garrison": 1,
