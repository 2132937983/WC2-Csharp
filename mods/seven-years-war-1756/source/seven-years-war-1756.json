    { "id": "dkn", "art": "dk", "faction": "denmark", "tags": ["kingdom"], "name": { "en": "DENMARK-NORWAY", "cn": "丹麦-挪威" },
      "intro": { "en": "Frederick V rules Denmark, Norway, Iceland, Greenland and the duchies of Schleswig and Holstein. Copenhagen will stay neutral and trade with both sides.", "cn": "弗雷德里克五世统治着丹麦、挪威、冰岛、格陵兰以及石勒苏益格和荷尔斯泰因公国。哥本哈根将保持中立，并与双方通商。" },
