    { "id": "hbc", "faction": "anglo", "tags": ["company"], "name": { "en": "HUDSON'S BAY COMPANY", "cn": "哈德逊湾公司" },
      "intro": { "en": "The Company's charter gives it every river that runs into Hudson Bay: Rupert's Land, from York Factory to the prairies. Its forts trade furs with the Cree and watch the French from Montreal.", "cn": "公司的特许状把流入哈德逊湾的每一条河流都划给了它：鲁珀特地，从约克工厂一直延伸到大草原。它的堡垒与克里人交易毛皮，并提防着来自蒙特利尔的法国人。" },
      "color": [180, 80, 70], "capital": [-92.4, 57.0],
      "flag": { "bands": ["#b22234"], "overlays": [
        { "type": "path", "symbol": "union", "x": 0.25, "y": 0.25, "w": 0.5, "h": 0.5, "colors": { "field": "#012169", "white": "#ffffff", "red": "#c8102e" } },
        { "type": "text", "text": "HBC", "x": 0.72, "y": 0.74, "h": 0.24, "color": "#ffffff" } ] } },

    // ---- the Franco-Austrian Alliance
    { "id": "fr", "art": "fr", "faction": "franco", "tags": ["great power"],
      "name": { "en": "KINGDOM OF FRANCE", "cn": "法兰西王国" },
      "intro": { "en": "Louis XV has made peace with the Habsburgs and war with Britain. France is the richest and most populous kingdom of Europe, with New France and Louisiana in America, Saint-Domingue in the Caribbean and Dupleix's posts in India. Its navy is half the size of Britain's.", "cn": "路易十五与哈布斯堡家族讲和，转而与英国开战。法国是欧洲最富庶、人口最多的王国，在美洲拥有新法兰西和路易斯安那，在加勒比海拥有圣多明各，在印度拥有杜普雷的据点。但它的海军只有英国的一半。" },
      "color": [80, 110, 190], "commander": "de Gaulle", "techLevel": 3, "capital": [2.35, 48.86], "garrison": 1, "fleets": 7, "fleetUnit": "battleship", "economy": 1.4,
      "flag": { "bands": ["#fbfaf2"], "overlays": [ { "type": "path", "symbol": "fleur", "h": 0.27, "colors": { "lis": "#d4a017" },
        "at": [[0.14, 0.2], [0.42, 0.2], [0.7, 0.2], [0.98, 0.2], [0.28, 0.5], [0.56, 0.5], [0.84, 0.5], [0.0, 0.5], [0.14, 0.8], [0.42, 0.8], [0.7, 0.8], [0.98, 0.8]] } ] } },
    { "id": "hab", "art": "hu", "faction": "franco", "tags": ["great power"],
      "name": { "en": "HABSBURG MONARCHY", "cn": "哈布斯堡君主国" },
      "intro": { "en": "Maria Theresa has never accepted the loss of Silesia. Kaunitz has turned France from an enemy into an ally, Russia is ready to march, and the lands of the Monarchy reach from the Austrian Netherlands to Transylvania and Milan.", "cn": "玛丽亚·特蕾莎从未接受失去西里西亚。考尼茨把法国从敌人变成了盟友，俄国已准备出兵，君主国的领土从奥属尼德兰一直延伸到特兰西瓦尼亚和米兰。" },
      "color": [235, 215, 110], "commander": "Rommel", "techLevel": 3, "capital": [16.37, 48.21], "garrison": 1, "fleets": 1, "economy": 1.3,
      "flag": { "bands": ["#f2c418"], "overlays": [ { "type": "path", "symbol": "eagle2", "x": 0.5, "y": 0.5, "h": 0.94, "colors": { "body": "#111111", "crown": "#7a5c12" } } ] } },
    { "id": "ru", "art": "ru", "faction": "franco", "tags": ["great power"],
      "name": { "en": "RUSSIAN EMPIRE", "cn": "俄罗斯帝国" },
      "intro": { "en": "Empress Elizabeth hates Frederick and has promised Austria eighty thousand men. Russia stretches from the Baltic to the Pacific; its army is slow but enormous. It enters the war in round 5.", "cn": "伊丽莎白女皇憎恨腓特烈，已向奥地利许诺八万大军。俄国从波罗的海延伸到太平洋；它的军队行动迟缓，但规模庞大。它将在第5回合参战。" },
      "color": [90, 150, 95], "commander": "Zhukov", "techLevel": 2, "capital": [30.31, 59.94], "garrison": 1, "fleets": 2, "economy": 1.1,
      "flag": { "bands": ["#ffffff", "#1f4fa8", "#d52b1e"] } },
    { "id": "es", "art": "es", "faction": "franco", "tags": ["great power", "maritime"],
      "name": { "en": "SPANISH EMPIRE", "cn": "西班牙帝国" },
      "intro": { "en": "Ferdinand VI keeps Spain out of the war, but its empire runs from California's edge to Cape Horn and the Philippines, and the Bourbon kings of France and Spain are cousins. Spain enters the war in round 12.", "cn": "费尔南多六世让西班牙置身战外，但它的帝国从加利福尼亚边缘一直延伸到合恩角和菲律宾，而且法国和西班牙的波旁国王是堂兄弟。西班牙将在第12回合参战。" },
      "color": [225, 180, 70], "techLevel": 2, "capital": [-3.70, 40.42], "garrison": 1, "fleets": 6, "fleetUnit": "cruiser", "economy": 1.2,
      "flag": { "bands": ["#fbfaf2"], "overlays": [ { "type": "raggedSaltire", "color": "#c60b1e", "width": 0.1 } ] } },
    { "id": "se", "art": "se", "faction": "franco", "tags": ["kingdom"],
      "name": { "en": "KINGDOM OF SWEDEN", "cn": "瑞典王国" },
      "intro": { "en": "The Hats in the Riksdag want back what Sweden lost to Prussia in Pomerania. Sweden still holds Finland, Stralsund and Wismar. It enters the war in round 6.", "cn": "议会中的礼帽党想夺回瑞典在波美拉尼亚输给普鲁士的土地。瑞典仍拥有芬兰、施特拉尔松德和维斯马。它将在第6回合参战。" },
      "color": [90, 150, 210], "techLevel": 2, "capital": [18.07, 59.33], "fleets": 2,
      "flag": { "bands": ["#005293"], "overlays": [ { "type": "cross", "x": 0.375, "y": 0.5, "width": 0.2, "color": "#fecb00" } ] } },
    { "id": "sax", "faction": "franco", "tags": ["electorate"], "name": { "en": "ELECTORATE OF SAXONY", "cn": "萨克森选侯国" },
      "intro": { "en": "Augustus III is Elector of Saxony and King of Poland. Saxony is rich, its army small, and it lies between Prussia and Bohemia: Frederick's road to Austria runs through Dresden.", "cn": "奥古斯特三世既是萨克森选侯，也是波兰国王。萨克森富庶，军队弱小，又夹在普鲁士和波希米亚之间：腓特烈通往奥地利的道路正穿过德累斯顿。" },
      "color": [130, 175, 110], "capital": [13.74, 51.05], "garrison": 1,
      "flag": { "bands": ["#111111", "#e8b923", "#111111", "#e8b923", "#111111", "#e8b923", "#111111", "#e8b923", "#111111", "#e8b923"],
        "overlays": [ { "type": "path", "symbol": "crancelin", "full": true, "colors": { "green": "#2e8b37" } } ] } },
