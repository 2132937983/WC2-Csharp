<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tools: builds the runtime asset package from the untouched original assets and the
       authored content (run automatically by the WC2 and WC2.Android builds). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WC2.Tools</RootNamespace>
    <AssemblyName>WC2.Tools</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>
</Project>
