<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine layer: the port of the easytech engine API (renderer, GUI toolkit, fonts, sound,
       state machine) plus the asset system, mods and JSON layering. It has no reference to the game,
       so the compiler keeps the layering honest. The desktop build uses this library; the Android
       project compiles the same sources directly (see Hosts/Android/WC2.Android.csproj). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WC2</RootNamespace>
    <AssemblyName>WC2.Engine</AssemblyName>
    <!-- The port keeps the original C++ field names and some unused members on purpose. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0168;CS0219;CS0414;CS0649;CS0659;CS0661;CS8981;CS1717;CS0162;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WC2.Data" />
    <InternalsVisibleTo Include="WC2.Game" />
    <InternalsVisibleTo Include="WC2" />
    <InternalsVisibleTo Include="WC2.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
  </ItemGroup>
</Project>
