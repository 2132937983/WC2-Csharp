<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game: the port of the remake's game code (rules, AI, scene, screens), the readers of the
       JSON data, and the host pieces shared by desktop and Android (MonoGame Game host, script driver).
       It must not reference a host. The Android project compiles these sources directly
       (see Hosts/Android/WC2.Android.csproj). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WC2</RootNamespace>
    <AssemblyName>WC2.Game</AssemblyName>
    <!-- The port keeps the original C++ field names and some unused members on purpose. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0168;CS0219;CS0414;CS0649;CS0659;CS0661;CS8981;CS1717;CS0162;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WC2" />
    <InternalsVisibleTo Include="WC2.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/WC2.Engine.csproj" />
    <ProjectReference Include="../Data/WC2.Data.csproj" />
  </ItemGroup>
</Project>
