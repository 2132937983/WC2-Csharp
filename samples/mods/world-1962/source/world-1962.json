{
  // 1962 - DIVIDED WORLD: an original alternate-history conquest on the Natural Earth world map.
  // Premise: the war in Europe ended in 1943 with an armistice; the Soviet state fell back behind the
  // Urals and broke apart; the Pacific war ended in a truce in 1945. Twenty years later Berlin, Tokyo
  // and Washington lead three blocs, the Non-Aligned keep out, and the Russian successor states fight
  // each other and the Reich. Borders follow wartime plans (the Reichskommissariate, Himmler's
  // Burgundy, Greater Finland, the Co-Prosperity Sphere, the Arkhangelsk-Astrakhan line), not any
  // existing game.
  //
  // Build:  dotnet run --project Tools -- build-scenario --config samples/mods/world-1962/source/world-1962.json
  // Every field: MODDING.md, "A total conversion: build-scenario".

  "mod": {
    "id": "world-1962",
    "name": "1962: Divided World",
    "version": "1.0",
    "description": "Conquest 12: an original alternate 1962 on the world map, 66 countries in four blocs and six Russian successor states, with timed wars and peace. Needs the world map (map-natural-earth, built in). Sample of MODDING.md, 'A total conversion'.",
    "priority": 1
  },
  "conquest": 12,
  "map": {
    "id": 2,
    "pack": "assets/data/maps/natural-earth",
    "areas": "mods/map-natural-earth/data/json/maps/2/areas.json"
  },
  "texts": {
    "name": { "en": "1962 DIVIDED WORLD", "cn": "1962 分裂的世界" },
    "age": { "en": "1962", "cn": "1962" },
    "intro": {
      "en": "Spring 1962. The war ended in armistices nobody trusts. Berlin rules Europe to the Volga, Tokyo the Pacific shore of Asia, Washington the Americas; the Non-Aligned keep apart, and beyond the Urals the heirs of the Soviet state fight over its ruins. The truces will not last: the Pacific in round 10, the Atlantic in round 15, the Axis itself in round 25.",
      "cn": "1962年春。战争以无人信任的停战告终。柏林统治着直到伏尔加河的欧洲，东京掌控亚洲的太平洋沿岸，华盛顿主导美洲；不结盟国家置身事外，而在乌拉尔山以东，苏维埃国家的继承者们在废墟上互相争斗。停战不会长久：太平洋停战在第10回合结束，大西洋停战在第15回合结束，轴心国自身在第25回合分裂。"
    }
  },
  "button": { "title": "1962 DIVIDED WORLD", "lon": 40, "lat": 50, "degreesWide": 110 },
  "camera": { "lon": 30, "lat": 52 },
  "fogOfWar": false,
  "leftRightWrap": true,

  // money = (200 + taxes) x economy, industry = (100 + taxes / 2) x economy, like WORLD 1939
  "economy": { "moneyBase": 200, "moneyPerTax": 1.0, "industryBase": 100, "industryPerTax": 0.5 },

  "defaults": {
    "commander": "common1",
    "techLevel": 3,
    "taxFactor": 1.2,
    "fleets": 1,
    "transportCards": true,
    "units": {
      "capital": ["infantry", "infantry", "tank"],
      "largeCity": ["infantry", "artillery"],
      "city": ["infantry"],
      "port": ["infantry"]
    },
    "intro": {
      "en": "Spring 1962. Twenty years after the armistices the world is split between Berlin, Tokyo and Washington, and the truces are running out.",
      "cn": "1962年春。停战二十年后，世界被柏林、东京和华盛顿瓜分，而停战期限即将到来。"
    },
    "victory": {
      "en": "Defeat every country at war with you or bound to be. Countries at lasting peace with you need not fall.",
      "cn": "击败所有正在或将要与你交战的国家。与你永久和平的国家无需消灭。"
    }
  },

  // Factions: each is a side of its own (alliance numbers 5 and up); members are allies.
  "factions": [
    { "id": "pact", "name": { "en": "Berlin Pact", "cn": "柏林公约" }, "color": [96, 104, 118], "leader": "de", "tags": ["bloc", "axis"] },
    { "id": "sphere", "name": { "en": "Co-Prosperity Sphere", "cn": "大东亚共荣圈" }, "color": [214, 72, 64], "leader": "ja", "tags": ["bloc", "axis"] },
    { "id": "atlantic", "name": { "en": "Atlantic Alliance", "cn": "大西洋联盟" }, "color": [64, 120, 220], "leader": "am", "tags": ["bloc"] },
    { "id": "nonaligned", "name": { "en": "Non-Aligned Movement", "cn": "不结盟运动" }, "color": [235, 235, 225], "leader": "in", "tags": ["neutral"] },
    { "id": "soviet", "name": { "en": "Soviet Remnant", "cn": "苏维埃残余" }, "color": [190, 30, 30], "leader": "sov", "tags": ["successor"] },
    { "id": "orenburg", "name": { "en": "Orenburg Host", "cn": "奥伦堡哥萨克军" }, "color": [70, 110, 190], "leader": "orb", "tags": ["successor"] },
    { "id": "siberia", "name": { "en": "Siberian Republic", "cn": "西伯利亚共和国" }, "color": [60, 150, 90], "leader": "sib", "tags": ["successor"] },
    { "id": "fareast", "name": { "en": "Far Eastern Republic", "cn": "远东共和国" }, "color": [150, 60, 150], "leader": "fer", "tags": ["successor"] },
    { "id": "alash", "name": { "en": "Alash Autonomy", "cn": "阿拉什自治" }, "color": [70, 170, 210], "leader": "ala", "tags": ["successor"] },
    { "id": "bukhara", "name": { "en": "Emirate of Bukhara", "cn": "布哈拉埃米尔国" }, "color": [40, 120, 70], "leader": "bkh", "tags": ["successor"] }
  ],

  // Relations: different sides are at war unless a relation says otherwise; the last matching entry
  // that holds in a round decides. "until" is the round the peace ends (war from then on).
  "relations": [
    { "between": ["sphere", "atlantic"], "state": "peace", "until": 10,
      "announce": { "commander": "Nimitz", "end": {
        "en": "Round 10. A Japanese convoy has been sunk off Midway and Tokyo blames Washington. The Pacific truce is over: the Co-Prosperity Sphere and the Atlantic Alliance are at war.",
        "cn": "第10回合。一支日本船队在中途岛附近被击沉，东京指责华盛顿。太平洋停战结束：大东亚共荣圈与大西洋联盟正式开战。" } } },
    { "between": ["pact", "atlantic"], "state": "peace", "until": 15,
      "announce": { "commander": "Patton", "end": {
        "en": "Round 15. The Berlin talks on the Atlantic islands have collapsed. The Berlin Pact and the Atlantic Alliance are at war.",
        "cn": "第15回合。关于大西洋岛屿的柏林谈判破裂。柏林公约与大西洋联盟正式开战。" } } },
    { "between": ["pact", "sphere"], "state": "peace", "until": 25,
      "announce": { "commander": "Yamamoto", "end": {
        "en": "Round 25. Berlin and Tokyo have fallen out over Central Asia and the oil of Persia. The Axis is no more: the Berlin Pact and the Co-Prosperity Sphere are at war.",
        "cn": "第25回合。柏林与东京因中亚和波斯石油反目。轴心国不复存在：柏林公约与大东亚共荣圈正式开战。" } } },
    { "between": ["tag:successor", "atlantic"], "state": "peace" },
    { "between": ["tag:successor", "sphere"], "state": "peace" },
    { "between": ["fareast", "sphere"], "state": "war" },
    { "between": ["country:roc", "sphere"], "state": "war" },
    { "between": ["nonaligned", "*"], "state": "peace" }
  ],

