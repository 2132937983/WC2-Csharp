<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.wc2remake.csharp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.8</ApplicationDisplayVersion>
    <RootNamespace>WC2</RootNamespace>
    <AssemblyName>WC2.Android</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidKeyStore>false</AndroidKeyStore>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0168;CS0219;CS0414;CS0649;CS0659;CS0661;CS8981;CS1717;CS0162;CS0067;CA1416;XA4211</NoWarn>
    <!-- Local tool chain; override on the command line with -p:AndroidSdkDirectory=... if needed. -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('C:\Android')">C:\Android</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('C:\Program Files\Java\jdk-17.0.2')">C:\Program Files\Java\jdk-17.0.2</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine and game libraries target desktop MonoGame, so the APK compiles their sources
         directly against MonoGame.Framework.Android (one assembly, the game's global usings). -->
    <Compile Include="..\WC2.Game\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="..\WC2.Engine\**\*.cs" Exclude="..\WC2.Engine\obj\**;..\WC2.Engine\bin\**;..\WC2.Engine\GlobalUsings.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\WC2.Game\**\*.cs" Exclude="..\WC2.Game\obj\**;..\WC2.Game\bin\**;..\WC2.Game\GlobalUsings.cs" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build order only: the package tool must exist before BuildAssetPack runs. -->
    <ProjectReference Include="../WC2.Tools/WC2.Tools.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net9.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <PropertyGroup>
    <AssetPackTool>$(MSBuildThisFileDirectory)../WC2.Tools/bin/$(Configuration)/net9.0/WC2.Tools.dll</AssetPackTool>
    <AssetPackDir>$(MSBuildThisFileDirectory)obj/pack/</AssetPackDir>
    <AssetPackSource>$(MSBuildThisFileDirectory)../WC2/</AssetPackSource>
  </PropertyGroup>
  <!-- The original assets plus the authored content become the runtime package (WC2.Tools build-pack),
       which ships as assets/pack/... in the APK and is read in place at run time. -->
  <Target Name="BuildAssetPack" AfterTargets="ResolveProjectReferences">
    <Exec Command="dotnet &quot;$(AssetPackTool)&quot; build-pack --assets &quot;$(AssetPackSource)assets&quot; --content &quot;$(AssetPackSource)content&quot; --layout &quot;$(AssetPackSource)assets-layout.json&quot; --out &quot;$(AssetPackDir)&quot;" />
    <ItemGroup>
      <_AssetPackFile Include="$(AssetPackDir)**/*" />
      <AndroidAsset Include="@(_AssetPackFile)" Link="Assets\pack\%(_AssetPackFile.RecursiveDir)%(_AssetPackFile.Filename)%(_AssetPackFile.Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
  </ItemGroup>
</Project>
