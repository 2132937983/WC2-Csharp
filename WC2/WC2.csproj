<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WC2</RootNamespace>
    <AssemblyName>WC2</AssemblyName>
    <!-- The port keeps the original C++ field names and some unused members on purpose. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0168;CS0219;CS0414;CS0649;CS0659;CS0661;CS8981;CS1717;CS0162;CS0067</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- The original assets are never copied as they are: after every build WC2.Tools turns them
         (plus the authored files in "content") into the runtime package "pack" next to the program. -->
    <Compile Remove="assets\**" />
    <None Remove="assets\**" />
    <Compile Remove="content\**" />
    <Compile Remove="Content\**" />
    <None Remove="Content\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- The desktop program: Program.cs and the debug tools. Engine and game are libraries. -->
    <ProjectReference Include="..\WC2.Engine\WC2.Engine.csproj" />
    <ProjectReference Include="..\WC2.Game\WC2.Game.csproj" />
    <!-- Build order only: the package tool must exist before the BuildAssetPack target runs. -->
    <ProjectReference Include="..\WC2.Tools\WC2.Tools.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <PropertyGroup>
    <AssetPackTool>$(MSBuildThisFileDirectory)../WC2.Tools/bin/$(Configuration)/net9.0/WC2.Tools.dll</AssetPackTool>
    <!-- the asset tree of the repository (ASSET_LAYOUT.md); the build keeps generated/asset_index.json current for review -->
    <AssetPackArgs>--assets "$(MSBuildThisFileDirectory)../assets" --index-copy "$(MSBuildThisFileDirectory)../generated/asset_index.json"</AssetPackArgs>
  </PropertyGroup>
  <Target Name="BuildAssetPack" AfterTargets="Build">
    <Exec Command="dotnet &quot;$(AssetPackTool)&quot; build-pack $(AssetPackArgs) --out &quot;$(OutDir)pack&quot;" />
  </Target>
</Project>
