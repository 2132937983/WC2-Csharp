{
  // Where each original asset goes in the runtime package (WC2.Tools build-pack).
  // "match" is a case-insensitive regex on the path inside WC2/assets; the first matching rule wins.
  // "to" is the package path: {name} = file name, {1}..{9} = regex groups. File names never change,
  // so every original stays reachable by its old name (index.json aliases) and mods can replace a
  // file either at its package path or by its file name.
  "rules": [
    // language folders and every language-specific file: lang/<code>/
    { "match": "^English\\.lproj/(.+)$", "to": "lang/en/{1}" },
    { "match": "^zh_CN\\.lproj/(.+)$", "to": "lang/cn/{1}" },
    { "match": "^zh_TW\\.lproj/(.+)$", "to": "lang/tw/{1}" },
    { "match": "^ja\\.lproj/(.+)$", "to": "lang/ja/{1}" },
    { "match": "^kr\\.lproj/(.+)$", "to": "lang/kr/{1}" },
    { "match": "^ru\\.lproj/(.+)$", "to": "lang/ru/{1}" },

    // unit animation sets of the battle animation (country codes look like language codes, so first)
    { "match": "^(infantry|artillery|panzer|tank|heavytank|rocketlauncher|cannon|destroyer|cruiser|battleship|aircraftcarrier)_[a-z]{2}(_hd)?\\.(xml|png|bin)$", "to": "gfx/battle/units/{name}" },
    { "match": "^(aircraftcarrier|battleship|cruiser|destroyer)\\.bin$", "to": "gfx/battle/units/{name}" },
    { "match": "^(motiondef|unitposdef)\\.xml$", "to": "gfx/battle/{name}" },
    { "match": "^battlebg", "to": "gfx/battle/{name}" },

    { "match": "^stringtable_([a-z]{2})(_ipad)?\\.xml$", "to": "lang/{1}/{name}" },
    { "match": "^.+_ko(_hd)?(@2x)?\\.(png|webp)$", "to": "lang/kr/{name}" },
    { "match": "^.+_(cn|en|ja|kr|ru|tw)(_hd|_ipad|_ipad_hd)?(@2x)?\\.(fnt|png|webp|xml|pkm)$", "to": "lang/{1}/{name}" },

    // map 1: background tiles, minimap, area overlay atlases, geometry and tax tables
    { "match": "^map(\\d+)_\\d+(@2x)?\\.pkm$", "to": "maps/{1}/tiles/{name}" },
    { "match": "^minimap(\\d+)_", "to": "maps/{1}/minimap/{name}" },
    { "match": "^m(\\d+)_(zone|conquest)", "to": "maps/{1}/zones/{name}" },
    { "match": "^(area|adjion|areamark|areatax)(\\d+)\\.(bin|raw|xml)$", "to": "maps/{2}/{name}" },
    { "match": "^box\\d+(@2x)?\\.png$", "to": "maps/common/{name}" },

    // scenarios: campaign battles, conquests, the tutorial
    { "match": "^(battle_[a-z]+\\d+|conquest_\\d+)\\.(xml|bin)$", "to": "scenarios/{name}" },
    { "match": "^tutorails\\.(xml|bin)$", "to": "scenarios/{name}" },
    { "match": "^tutorails_script", "to": "scenarios/tutorial/{name}" },
    { "match": "^tutorails", "to": "gfx/tutorial/{name}" },

    // original data tables (the game reads the JSON versions in data/; these stay for reference)
    { "match": "^(armydef|armydef-bak|carddef|commanderdef|battlelist|conquestlist|generalphotos|guioptions)\\.xml$", "to": "data/original/{name}" },

    // leftovers of the original tool chain, store and service screens
    { "match": "^(conquest|resolutionColumns|iap_extra|fullscreen|editres)\\.(xml|png)$", "to": "legacy/{name}" },
    { "match": "^map\\.ini$", "to": "legacy/{name}" },

    // fonts without a language
    { "match": "^(font\\d|font_[a-z]+|num\\d+[a-z]?|fps)[^/]*\\.(fnt|png)$", "to": "fonts/{name}" },

    // audio
    { "match": "\\.mp3$", "to": "audio/music/{name}" },
    { "match": "\\.wav$", "to": "audio/sfx/{name}" },

    // graphics
    { "match": "^(eff|effect_[^.]+)\\.(xml|png)$", "to": "gfx/effects/{name}" },
    { "match": "^general_[a-z]+(@2x)?\\.webp$", "to": "gfx/portraits/{name}" },
    { "match": "^general(_hd)?\\.(xml|webp)$", "to": "gfx/portraits/{name}" },
    { "match": "^(army|flag)(_hd)?\\.(xml|png|webp)$", "to": "gfx/units/{name}" },
    { "match": "-568h", "to": "gfx/ui/phone-568/{name}" },
    { "match": "-640h", "to": "gfx/ui/phone-640/{name}" },
    { "match": "_ipad", "to": "gfx/ui/tablet/{name}" },
    { "match": "\\.(png|webp|pkm|xml)$", "to": "gfx/ui/{name}" },

    // anything else
    { "match": ".*", "to": "misc/{name}" }
  ],

  // Runtime formats generated next to their sources ("match" is a regex on the package path).
  // rgba4444: the 4096 px Kai/Hei glyph pages (white glyphs, shape in alpha) as 16 bit pixels:
  // 32 MB instead of 64 MB each on the GPU and no PNG decode when the game starts.
  "runtimeFormats": [
    { "match": "^lang/cn/font(ht|kt)_cn_hd\\.png$", "format": "rgba4444" }
  ]
}
