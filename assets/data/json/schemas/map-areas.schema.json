{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-areas.schema.json",
  "title": "Per-area table of a map (type, tax)",
  "description": "Field reference: DATA_SCHEMA.md. Checked whenever the game loads the file (mods included).",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Version of this file format."
    },
    "about": {
      "type": "string",
      "description": "Free text for people reading the file."
    },
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "tax": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "tax"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "areas"
  ],
  "additionalProperties": false
}
