{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-regions.schema.json",
  "title": "Regions of a map pack (regions.json)",
  "description": "Field reference: MAP_PIPELINE.md. Generated by WC2.Tools build-map.",
  "type": "object",
  "required": [
    "regions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "about": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "center",
          "pixel",
          "areaKm2",
          "neighbours"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "sea": {
            "const": true
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "capital",
              "port",
              "large city",
              "normal city",
              "normal"
            ]
          },
          "city": {
            "type": "object",
            "required": [
              "name",
              "population"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "population": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "port": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "airfield": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "coastal": {
            "const": true
          },
          "provinces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "pixel": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "areaKm2": {
            "type": "integer",
            "minimum": 0
          },
          "neighbours": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "owners": {
            "type": "object",
            "description": "Era -> the unit holding the region then (map.json eras).",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
