{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conquests.schema.json",
  "title": "Conquests on the selection map",
  "description": "Field reference: DATA_SCHEMA.md. Checked whenever the game loads the file (mods included).",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Version of this file format."
    },
    "about": {
      "type": "string",
      "description": "Free text for people reading the file."
    },
    "conquests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "centerX": {
            "type": "integer"
          },
          "centerY": {
            "type": "integer"
          },
          "fogOfWar": {
            "type": "boolean",
            "description": "Hide the armies in areas the player's alliance cannot see (default false)."
          },
          "leftRightWrap": {
            "type": "boolean",
            "description": "The map repeats horizontally: the camera scrolls past the left and right edge (default false; the map must span the whole width, like the world map)."
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                },
                "scale": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "centerX",
          "centerY",
          "flags"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "conquests"
  ],
  "additionalProperties": false
}
