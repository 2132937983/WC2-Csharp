{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-pack.schema.json",
  "title": "Map pack description (map.json of a generated map pack)",
  "description": "Field reference: MAP_PIPELINE.md. Generated by WC2.Tools build-map.",
  "type": "object",
  "required": [
    "id",
    "bounds",
    "raster",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "about": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "projection": {
      "enum": [
        "equirectangular"
      ]
    },
    "bounds": {
      "type": "object",
      "required": [
        "west",
        "east",
        "north",
        "south"
      ],
      "additionalProperties": false,
      "properties": {
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "raster": {
      "type": "object",
      "required": [
        "file",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "pixelsPerDegree": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "landRegions": {
      "type": "integer",
      "minimum": 1
    },
    "seaZones": {
      "type": "integer",
      "minimum": 0
    },
    "countries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "regions"
        ],
        "additionalProperties": false,
        "properties": {
          "regions": {
            "type": "integer",
            "minimum": 1
          },
          "capital": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "The build-map configuration the pack was made with."
    },
    "wrap": {
      "type": "boolean",
      "description": "The map spans the whole width and wraps left-right."
    },
    "eras": {
      "type": "object",
      "description": "The eras of the base map: their source and units (owners in regions.json).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "units": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "capital": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
