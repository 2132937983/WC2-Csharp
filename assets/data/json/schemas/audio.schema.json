{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio.schema.json",
  "title": "Which sound plays for what",
  "description": "Field reference: DATA_SCHEMA.md. Checked whenever the game loads the file (mods included).",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Version of this file format."
    },
    "about": {
      "type": "string",
      "description": "Free text for people reading the file."
    },
    "music": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "preload": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "music",
    "ui",
    "effects",
    "preload"
  ],
  "additionalProperties": false
}
