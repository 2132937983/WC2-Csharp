{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text.schema.json",
  "title": "Texts of one language (a string table or Localizable)",
  "description": "Field reference: DATA_SCHEMA.md. Checked whenever the game loads the file (mods included).",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Version of this file format."
    },
    "about": {
      "type": "string",
      "description": "Free text for people reading the file."
    },
    "strings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "strings"
  ],
  "additionalProperties": false
}
