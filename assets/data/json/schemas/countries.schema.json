{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "countries.schema.json",
  "title": "Countries with their own unit art, flag and commander badge",
  "description": "Field reference: DATA_SCHEMA.md. Checked whenever the game loads the file (mods included).",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Version of this file format."
    },
    "about": {
      "type": "string",
      "description": "Free text for people reading the file."
    },
    "countries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commanderMedal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "commonMedals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "countries",
    "commonMedals"
  ],
  "additionalProperties": false
}
