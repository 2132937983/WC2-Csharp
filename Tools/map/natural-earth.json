{
  // WC2.Tools build-map configuration for the Natural Earth world map (MAP_PIPELINE.md).
  "id": "natural-earth",
  "name": "World (Natural Earth)",

  // Coverage: north to southern Greenland (Cape Farewell 59.8 N), south to southern Madagascar
  // (25.6 S) and northern Australia; west to Alaska, east to the date line.
  "bounds": { "west": -170, "east": 180, "north": 62, "south": -26 },
  "raster": { "width": 4096 },

  // Provinces (Natural Earth admin-1) merge within their country until a region has minAreaKm2 and
  // a country has at most maxPerCountry regions. Islands smaller than minIslandKm2 are left out.
  "regions": { "minAreaKm2": 40000, "maxPerCountry": 30, "minIslandKm2": 2500 },

  // Finer regions where the game's wars are fought (game ids): Europe and its neighbours.
  "regionOverrides": {
    "de": { "minAreaKm2": 18000 }, "fr": { "minAreaKm2": 20000 }, "gb": { "minAreaKm2": 15000 },
    "it": { "minAreaKm2": 18000 }, "es": { "minAreaKm2": 25000 }, "pl": { "minAreaKm2": 20000 },
    "nl": { "minAreaKm2": 10000 }, "be": { "minAreaKm2": 10000 }, "ch": { "minAreaKm2": 10000 },
    "ro": { "minAreaKm2": 20000 }, "hu": { "minAreaKm2": 15000 }, "gr": { "minAreaKm2": 15000 },
    "tr": { "minAreaKm2": 30000 }, "ru": { "maxPerCountry": 45 }, "ja": { "minAreaKm2": 20000 }
  },

  // Sea zones: a grid of cellDegrees, each cell split into its connected water parts; parts smaller
  // than minSeaPixels join a neighbouring zone.
  "sea": { "cellDegrees": 8, "minSeaPixels": 600 },
  "minBorderPixels": 2,

  // Populated places with POP_MAX >= minPopulation make a region a city (>= largeCityPopulation:
  // large city); a country's capital (ADM0CAP) makes its region the capital.
  "cities": { "minPopulation": 1000000, "largeCityPopulation": 5000000 },
  "ports": { "maxScalerank": 5 },
  "airfields": { "types": ["major", "major and military"], "maxScalerank": 4 },

  // --classic-out: the map in the scene's own formats as map 2, written as a mod with a conquest
  // (MAP_PIPELINE.md). players: the countries of the scenario (the rest of the land starts unowned).
  "classicExport": {
    "mapId": 2, "scale": 2, "scenario": "conquest_10.xml",
    // the entry in the conquest list (conquest 10 follows the game's nine)
    "conquest": {
      "number": 10, "title": "WORLD (NATURAL EARTH)", "centerLon": 10, "centerLat": 48,
      "intro": "The world in today's borders, drawn from Natural Earth. {country} starts with its capital and its great cities; the rest of the land is unclaimed.",
      "victory": "Take the capitals of your enemies."
    },
    "modId": "map-natural-earth", "modName": "World map (Natural Earth)",
    "players": {
      "de": { "alliance": "a", "commander": "Guderian", "color": [71, 87, 99] },
      "it": { "alliance": "a", "commander": "Graziani", "color": [80, 20, 200] },
      "ja": { "alliance": "a", "commander": "Yamamoto", "color": [255, 128, 0] },
      "hu": { "alliance": "a", "color": [128, 64, 90] },
      "ro": { "alliance": "a", "color": [149, 55, 53] },
      "bg": { "alliance": "a", "color": [0, 0, 128] },
      "fl": { "alliance": "a", "color": [146, 205, 220] },
      "gb": { "alliance": "b", "commander": "Montgomery", "color": [255, 255, 0] },
      "fr": { "alliance": "b", "commander": "de Gaulle", "color": [0, 170, 170] },
      "am": { "alliance": "b", "commander": "Patton", "color": [64, 199, 64] },
      "ca": { "alliance": "b", "color": [0, 162, 232] },
      "au": { "alliance": "b", "color": [0, 49, 146] },
      "pl": { "alliance": "b", "color": [255, 128, 64] },
      "nl": { "alliance": "b", "color": [255, 192, 0] },
      "be": { "alliance": "b", "color": [148, 138, 84] },
      "no": { "alliance": "b", "color": [255, 0, 128] },
      "dk": { "alliance": "b", "color": [141, 180, 226] },
      "gr": { "alliance": "b", "color": [83, 141, 213] },
      "yu": { "alliance": "b", "color": [218, 150, 148] },
      "in": { "alliance": "b", "color": [0, 102, 0] },
      "mx": { "alliance": "b", "color": [64, 30, 169] },
      "tw": { "alliance": "b", "commander": "Zhang", "color": [0, 50, 200] },
      "rk": { "alliance": "b", "color": [128, 45, 34] },
      "ru": { "alliance": "c", "commander": "Rokossovsky", "color": [255, 0, 0] },
      "cn": { "alliance": "c", "commander": "Peng", "color": [255, 90, 90] },
      "nk": { "alliance": "c", "color": [255, 153, 153] },
      "es": { "alliance": "n", "color": [255, 0, 128] },
      "pt": { "alliance": "n", "color": [127, 127, 127] },
      "se": { "alliance": "n", "color": [0, 0, 204] },
      "ch": { "alliance": "n", "color": [141, 180, 0] },
      "tr": { "alliance": "n", "color": [0, 128, 192] }
    }
  },

  // Natural Earth ADM0_A3 -> the game's country ids (data/json/countries/countries.json); every other
  // country keeps its ISO code in lower case.
  "countries": {
    "GBR": "gb", "RUS": "ru", "USA": "am", "FRA": "fr", "JPN": "ja", "ITA": "it", "DEU": "de",
    "CAN": "ca", "FIN": "fl", "ROU": "ro", "BGR": "bg", "BEL": "be", "GRC": "gr", "CHN": "cn",
    "TWN": "tw", "IND": "in", "AUS": "au", "POL": "pl", "HUN": "hu", "SRB": "yu", "CHE": "ch",
    "SWE": "se", "PRT": "pt", "DNK": "dk", "NOR": "no", "NLD": "nl", "ESP": "es", "MEX": "mx",
    "PRK": "nk", "KOR": "rk", "TUR": "tr"
  }
}
