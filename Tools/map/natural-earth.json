{
  // WC2.Tools build-map configuration for the world base map (MAP_PIPELINE.md).
  "id": "natural-earth",
  "name": "World (1910-2018)",

  // Coverage: the whole width (the map wraps left-right), north to the Russian polar islands
  // (Franz Josef Land 81.9 N) and all of northern Europe, south to southern Madagascar (25.6 S) and
  // northern Australia.
  "bounds": { "west": -180, "east": 180, "north": 82, "south": -26 },
  "wrap": true,
  // 12.5 pixels per degree; the map mod doubles it (9000 x 2700 map units, a multiple of 1000 wide
  // so the wrap is seamless)
  "raster": { "width": 4500 },

  // The eras of the base map. Every era's borders are kept as region borders, so a scenario of any
  // of these years only assigns owners (MAP_PIPELINE.md, "One map for every era").
  "eras": {
    "1910": { "date": "1910-01-01" },
    "1914": { "date": "1914-07-01" },
    "1936": { "date": "1936-01-01" },
    "1939": { "date": "1939-09-01" },
    "1945": { "date": "1945-09-02" },
    "1949": { "date": "1949-12-31" },
    "2018": { "source": "naturalearth" }
  },
  // Historical borders: CShapes 2.0 (states and colonies with dates). Fragments of another unit than
  // a province's main one smaller than minFragmentKm2 or nowhere minFragmentWidthPixels thick are two
  // sources tracing one border apart and join their neighbour. fallback: the unit (CShapes gwcode) of
  // Natural Earth countries CShapes leaves out.
  "historicalBorders": {
    "file": "CShapes-2.0.geojson",
    "minFragmentKm2": 1500,
    "minFragmentWidthPixels": 2,
    "fallback": { "GRL": "390", "SJM": "385", "HKG": "200", "KWT": "200" },
    // corrections of the source: CShapes draws the German Empire without the Memel Territory (north of the
    // Neman, German until 1920) and Memel Lithuanian on 1 September 1939 (annexed by Germany in March 1939)
    "corrections": [
      {
        "name": "Memel Territory", "unit": "255", "eras": ["1910", "1914", "1939"],
        "polygon": [21.06, 55.88, 21.25, 55.88, 21.32, 55.78, 21.35, 55.68, 21.45, 55.60, 21.55, 55.47, 21.65, 55.38,
                    21.80, 55.28, 22.05, 55.17, 22.35, 55.12, 22.62, 55.08, 22.40, 55.06, 22.10, 55.07, 21.88, 55.09,
                    21.60, 55.17, 21.40, 55.27, 21.25, 55.32, 20.95, 55.27, 20.98, 55.50, 21.05, 55.72]
      }
    ]
  },
  // The CShapes units that are the game's countries at home: their capitals of every era become
  // capital areas (Saint Petersburg, Nanking, Bonn, ...).
  "homeUnits": {
    "am": ["2"], "gb": ["200"], "fr": ["220"], "de": ["255", "260"], "it": ["325"], "ja": ["740"], "ru": ["365"],
    "ca": ["20"], "au": ["900"], "mx": ["70"], "pl": ["290"], "hu": ["310", "300"], "ro": ["360"], "bg": ["355"],
    "yu": ["345"], "gr": ["350"], "fl": ["375"], "se": ["380"], "no": ["385"], "dk": ["390"], "nl": ["210"],
    "be": ["211"], "ch": ["225"], "pt": ["235"], "es": ["230"], "tr": ["640"], "tw": ["713"], "cn": ["710"],
    "in": ["750"], "nk": ["731"], "rk": ["732"]
  },

  // Provinces (Natural Earth admin-1) split along every era's borders, then merge again with
  // neighbours of the same borders in every era until they have mergeBelow x the target area of their
  // place ("detail"); groups above splitAbove x the target are cut into cells of about the target area
  // (seeded, grown inside the group, relaxed). Parts below minIslandKm2: enclaves join a neighbour,
  // islands are left out. Island groups farther than islandSplitDegrees from their region's main body
  // (parts closer than islandClusterDegrees form a group) become regions of their own; small ones
  // farther than maxPartDistanceDegrees are left out.
  // minPartKm2: a region in several pieces keeps its largest; a piece this large becomes a region of its own
  "regions": { "minIslandKm2": 1500, "minPartKm2": 1500, "islandSplitDegrees": 4, "islandClusterDegrees": 1.0, "maxPartDistanceDegrees": 25 },

  // Target region areas (km2): a country first, then the first zone containing the part, then the
  // default. Finest where the wars of the game are fought (Europe, East Asia), coarse in deserts, the
  // Arctic and Siberia: about 5 000 to 6 000 land regions.
  "detail": {
    "defaultKm2": 22000, "mergeBelow": 0.5, "splitAbove": 1.6,
    "countries": { "ja": 5000, "rk": 5000, "nk": 5000, "tw": 4000, "gl": 150000, "is": 9000 },
    "zones": [
      { "name": "western and central Europe", "west": -11, "east": 32, "south": 35, "north": 61, "km2": 5000 },
      { "name": "northern and eastern Europe", "west": -25, "east": 45, "south": 35, "north": 72, "km2": 8000 },
      { "name": "Turkey, the Caucasus, the Levant", "west": 25, "east": 50, "south": 29, "north": 45, "km2": 9000 },
      { "name": "North African coast", "west": -18, "east": 37, "south": 27, "north": 38, "km2": 10000 },
      { "name": "Sahara", "west": -18, "east": 37, "south": 15, "north": 27, "km2": 45000 },
      { "name": "East Asia", "west": 100, "east": 146, "south": 18, "north": 55, "km2": 9000 },
      { "name": "South and Southeast Asia", "west": 60, "east": 130, "south": -11, "north": 30, "km2": 15000 },
      { "name": "Middle East", "west": 35, "east": 63, "south": 12, "north": 40, "km2": 15000 },
      { "name": "Central Asia", "west": 45, "east": 100, "south": 30, "north": 55, "km2": 25000 },
      { "name": "Siberia and the Russian Far East", "west": 45, "east": 180, "south": 45, "north": 82, "km2": 45000 },
      { "name": "United States and southern Canada", "west": -130, "east": -52, "south": 24, "north": 55, "km2": 18000 },
      { "name": "Alaska and northern Canada", "west": -180, "east": -52, "south": 55, "north": 82, "km2": 60000 },
      { "name": "Central America and the Caribbean", "west": -118, "east": -59, "south": 7, "north": 24, "km2": 12000 },
      { "name": "South America", "west": -82, "east": -34, "south": -26, "north": 13, "km2": 25000 },
      { "name": "Africa south of the Sahara", "west": -18, "east": 52, "south": -26, "north": 18, "km2": 25000 },
      { "name": "northern Australia and Oceania", "west": 110, "east": 180, "south": -26, "north": -5, "km2": 30000 }
    ]
  },

  // Sea zones of irregular shape: seeds coastRadiusDegrees apart along the coasts, farther apart the
  // more open the water (radius + growth x distance from the coast, at most oceanRadiusDegrees), grown
  // through the water and relaxed relaxIterations times; zones below minSeaPixels join a neighbour.
  "sea": { "coastRadiusDegrees": 1.8, "oceanRadiusDegrees": 14, "growth": 0.9, "relaxIterations": 2, "minSeaPixels": 300 },
  "minBorderPixels": 2,
  // Water cut out of the provinces (the province layer covers lakes as land): the large lakes (Natural
  // Earth scalerank up to 2: the Great Lakes, Baikal, Ladoga, Victoria, ...) and the Aral Sea of 1960, as
  // inland seas with their own sea zones; the straits and canals as channels widthPixels wide, so ships
  // pass and land units cannot walk across (the sea zones on both sides connect through them).
  "water": {
    "lakes": { "file": "ne_10m_lakes.geojson", "maxScalerank": 2 },
    "historicLakes": { "file": "ne_10m_lakes_historic.geojson", "names": ["Aral Sea"] },
    "channels": [
      { "name": "Bosporus", "path": [29.13, 41.23, 29.07, 41.13, 29.02, 41.06, 28.99, 41.01], "widthPixels": 2.5 },
      { "name": "Dardanelles", "path": [26.70, 40.42, 26.56, 40.28, 26.38, 40.13, 26.20, 40.03], "widthPixels": 2.5 },
      { "name": "Suez Canal", "path": [32.30, 31.27, 32.33, 30.95, 32.28, 30.58, 32.40, 30.30, 32.56, 29.95], "widthPixels": 2.5 },
      { "name": "Panama Canal", "path": [-79.92, 9.38, -79.85, 9.20, -79.70, 9.10, -79.55, 8.95], "widthPixels": 2.5 },
      { "name": "Strait of Gibraltar", "path": [-5.95, 35.98, -5.60, 35.96, -5.25, 36.02], "widthPixels": 2.5 },
      { "name": "Oresund", "path": [12.62, 56.10, 12.70, 55.90, 12.68, 55.62], "widthPixels": 2.5 },
      { "name": "Strait of Kerch", "path": [36.52, 45.42, 36.58, 45.30, 36.62, 45.15], "widthPixels": 2.5 }
    ]
  },
  // Waterways the raster closes (a few kilometres wide): the sea zones at the two points become neighbours.
  "straits": [
    { "name": "Bosporus", "points": [29.3, 41.35, 28.9, 40.85] },
    { "name": "Dardanelles", "points": [27.0, 40.55, 26.0, 40.0] },
    { "name": "Gibraltar", "points": [-6.2, 35.9, -5.0, 36.1] },
    { "name": "Suez Canal", "points": [32.4, 31.4, 32.6, 29.7] },
    { "name": "Panama Canal", "points": [-79.9, 9.5, -79.5, 8.7] },
    { "name": "Kiel Canal", "points": [8.6, 54.0, 10.3, 54.5] },
    { "name": "Oresund", "points": [12.2, 56.3, 12.9, 55.3] },
    { "name": "Kerch", "points": [36.6, 45.6, 36.6, 44.9] },
    { "name": "Bab-el-Mandeb", "points": [43.0, 13.0, 43.8, 12.4] },
    // the Great Lakes, joined by their rivers (an inland sea of five zones)
    { "name": "St. Marys River", "points": [-84.8, 46.6, -84.0, 46.0] },
    { "name": "Straits of Mackinac", "points": [-85.2, 45.8, -84.4, 45.8] },
    { "name": "St. Clair and Detroit Rivers", "points": [-82.4, 43.4, -83.0, 41.9] },
    { "name": "Niagara River", "points": [-79.0, 42.8, -79.0, 43.4] }
  ],

  // Populated places with POP_MAX >= minPopulation make a region a city (>= largeCityPopulation:
  // large city); a country's capital (ADM0CAP) makes its region the capital.
  "cities": { "minPopulation": 1000000, "largeCityPopulation": 5000000 },
  "ports": { "maxScalerank": 5 },
  "airfields": { "types": ["major", "major and military"], "maxScalerank": 4 },
  // the era the pack's preview is coloured by; with --preview-dir every era is drawn, plus these close-ups
  "previewEra": "1939",
  "previewCrops": [
    { "name": "europe", "west": -12, "east": 45, "north": 72, "south": 34 },
    { "name": "east-asia", "west": 95, "east": 150, "north": 55, "south": 15 }
  ],

  // --classic-out: the map in the scene's own formats as map 2, written as a mod with its conquests
  // (MAP_PIPELINE.md).
  "classicExport": {
    // 8 map units per region raster pixel: 100 units per degree (36 000 x 10 800, a multiple of 1000
    // wide so the wrap is seamless; one region raster pixel = one 8 x 8 touch cell); the provinces are
    // drawn again at twice the region raster's resolution for the outlines. mesh: the map is drawn from
    // vertex buffers (map2.mesh) instead of image tiles and region masks.
    "mapId": 2, "scale": 8, "detailRaster": 2, "mesh": true,
    "meshSettings": { "tolerance": 0.9, "smoothing": 1, "chunkWidth": 1500 },
    // taxes follow the area (many small regions); display: zoom in up to maxZoom, the units of a
    // region whose fit radius is below unitFitRadius are scaled down (not below minUnitScale), below
    // markerZoom (units on screen) only a flag marks the armies, and flags stand only where armies or
    // buildings are (the mesh colours every province by its owner)
    "areaTax": "area",
    // the look (MapTerrainExport): Natural Earth II shaded relief graded towards parchment for the land,
    // a depth gradient with wave lines and foam for the water, the owners' colours over it at ownerAlpha
    "terrain": {
      "file": "ne2/NE2_50M_SR_W/NE2_50M_SR_W.tif", "pixelsPerDegree": 20, "columns": 8, "rows": 4, "quality": 86,
      "parchment": [224, 207, 163], "parchmentMix": 0.24, "shallow": [86, 136, 160], "deep": [28, 60, 96], "foam": [196, 214, 210],
      "depthPixels": 45, "waveLines": [5, 11, 19], "ownerAlpha": 0.38, "grainUnits": 600, "grainMinZoom": 0.12
    },
    "display": { "maxZoom": 3.0, "unitFitRadius": 46, "minUnitScale": 0.35, "markerZoom": 0.32, "flags": "armies" },
    "modId": "map-natural-earth", "modName": "World map 1910-2018 (Natural Earth, CShapes)",
    "scenarios": [
      {
        // conquest 10 follows the game's nine
        "number": 10, "file": "conquest_10.xml", "era": "1939", "title": "WORLD 1939",
        "centerLon": 12, "centerLat": 50,
        "fogOfWar": false, "leftRightWrap": true,
        "intro": "1 September 1939: Germany invades Poland. {country} begins in the borders of that day, with its colonies, dominions and occupied lands.",
        "victory": "Take the capitals of your enemies.",
        "names": {
          "gb": "British Empire", "ru": "Soviet Union", "am": "United States", "de": "German Reich", "it": "Kingdom of Italy",
          "ja": "Empire of Japan", "tw": "Republic of China", "yu": "Yugoslavia", "fr": "France"
        },
        // CShapes units (gwcode) of the era -> the game's country; every other unit starts unclaimed
        "owners": {
          "am": ["2", "3", "4", "6", "840"],
          "gb": ["200", "21", "31", "51", "52", "53", "80", "110", "338", "352", "420", "451", "452", "462", "472", "475", "500", "501",
                 "510", "511", "521", "551", "552", "553", "560", "565", "570", "571", "572", "590", "625", "645", "651", "663", "665",
                 "681", "6812", "694", "696", "698", "750", "775", "780", "781", "821", "822", "823", "824", "827", "835", "920", "940", "950"],
          "fr": ["220", "120", "1201", "65", "66", "432", "433", "434", "435", "436", "437", "438", "461", "471", "481", "482", "483",
                 "484", "522", "580", "585", "600", "615", "616", "652", "660", "811", "812", "815", "930", "960"],
          "nl": ["210", "115", "850"],
          "be": ["211", "490", "515"],
          "pt": ["235", "402", "404", "540", "541", "860"],
          "es": ["230", "411", "602", "610"],
          "it": ["325", "339", "530", "531", "5200", "620"],
          "de": ["255", "305", "315"],
          "ja": ["740", "730", "713", "7351"],
          "ru": ["365", "712"],
          "tw": ["710"],
          "ca": ["20"], "mx": ["70"], "au": ["900", "911", "912"], "pl": ["290"], "hu": ["310"], "ro": ["360"], "bg": ["355"],
          "yu": ["345"], "gr": ["350"], "fl": ["375"], "se": ["380"], "no": ["385"], "dk": ["390", "395"], "ch": ["225"], "tr": ["640"]
        },
        // provinces held by another country than their unit's: Manchukuo and the occupied north and
        // east of China
        "provinceOwners": {
          "ja": ["CN-HL", "CN-JL", "CN-LN", "CN-BJ", "CN-TJ", "CN-HE", "CN-SD", "CN-JS", "CN-SH", "CN-SX", "CN-HI"]
        },
        // alliances as in the game's 1939 conquest: a Axis, b Allies, c Comintern, n neutral (passive)
        "players": {
          "de": { "alliance": "a", "commander": "Guderian", "color": [71, 87, 99], "garrison": 1 },
          "it": { "alliance": "a", "commander": "Graziani", "color": [80, 20, 200] },
          "ja": { "alliance": "a", "commander": "Yamamoto", "color": [255, 128, 0], "garrison": 1 },
          "hu": { "alliance": "a", "color": [128, 64, 90] },
          "ro": { "alliance": "a", "color": [149, 55, 53] },
          "bg": { "alliance": "a", "color": [0, 0, 128] },
          "fl": { "alliance": "a", "color": [146, 205, 220] },
          "es": { "alliance": "a", "color": [255, 0, 128] },
          "gb": { "alliance": "b", "commander": "Montgomery", "color": [255, 255, 0], "garrison": 1 },
          "fr": { "alliance": "b", "commander": "de Gaulle", "color": [0, 170, 170], "garrison": 1 },
          "am": { "alliance": "b", "commander": "Patton", "color": [64, 199, 64] },
          "pl": { "alliance": "b", "color": [255, 128, 64] },
          "ca": { "alliance": "b", "color": [0, 162, 232] },
          "au": { "alliance": "b", "color": [0, 49, 146] },
          "nl": { "alliance": "b", "color": [255, 192, 0] },
          "be": { "alliance": "b", "color": [148, 138, 84] },
          "no": { "alliance": "b", "color": [255, 0, 128] },
          "dk": { "alliance": "b", "color": [141, 180, 226] },
          "gr": { "alliance": "b", "color": [83, 141, 213] },
          "yu": { "alliance": "b", "color": [218, 150, 148] },
          "mx": { "alliance": "b", "color": [64, 30, 169] },
          "tw": { "alliance": "b", "commander": "Zhang", "color": [0, 50, 200] },
          "ru": { "alliance": "c", "commander": "Zhukov", "color": [255, 0, 0], "garrison": 1 },
          "pt": { "alliance": "n", "color": [127, 127, 127] },
          "se": { "alliance": "n", "color": [0, 0, 204] },
          "ch": { "alliance": "n", "color": [141, 180, 0] },
          "tr": { "alliance": "n", "color": [0, 128, 192] }
        }
      }
    ]
  },

  // Natural Earth ADM0_A3 -> the game's country ids (data/json/countries/countries.json); every other
  // country keeps its ISO code in lower case.
  "countries": {
    "GBR": "gb", "RUS": "ru", "USA": "am", "FRA": "fr", "JPN": "ja", "ITA": "it", "DEU": "de",
    "CAN": "ca", "FIN": "fl", "ROU": "ro", "BGR": "bg", "BEL": "be", "GRC": "gr", "CHN": "cn",
    "TWN": "tw", "IND": "in", "AUS": "au", "POL": "pl", "HUN": "hu", "SRB": "yu", "CHE": "ch",
    "SWE": "se", "PRT": "pt", "DNK": "dk", "NOR": "no", "NLD": "nl", "ESP": "es", "MEX": "mx",
    "PRK": "nk", "KOR": "rk", "TUR": "tr"
  }
}
